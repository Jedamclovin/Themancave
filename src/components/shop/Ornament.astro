---
// The one divider used across the site: a hairline rule broken by a row of comb teeth.
// Takes its colour from the text colour.
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const teeth = Array.from({ length: 11 });
---

<div aria-hidden="true" class:list={["flex items-end gap-3", className]}>
	<span class="h-px flex-1 bg-current opacity-50"></span>
	<span class="flex items-end gap-[3px] border-b-2 border-current">
		{teeth.map(() => <span class="h-2.5 w-0.5 bg-current" />)}
	</span>
	<span class="h-px flex-1 bg-current opacity-50"></span>
</div>
