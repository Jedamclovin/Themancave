---
import Cta from "./Cta.astro";
import Ornament from "./Ornament.astro";
import SectionHead from "./SectionHead.astro";
import { copy, shop } from "@/data/shop";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(shop.mapQuery)}&z=16&output=embed`;
---

<section id="visit" class="defer-render overflow-x-clip px-5 pt-24 pb-24 md:px-10 lg:pt-40 lg:pb-40">
	<SectionHead number="07" title={copy.visit.title} />

	<div class="mt-14 lg:mt-20 lg:grid lg:grid-cols-12 lg:gap-x-8">
		<div class="relative z-10 lg:col-start-1 lg:col-end-6">
			<address class="not-italic">
				<p class="font-display text-[clamp(3.75rem,9vw,8.5rem)] leading-[0.82] font-black uppercase">
					{shop.street}
				</p>
				<p class="font-display text-primary mt-3 text-4xl leading-none font-bold uppercase md:text-5xl">
					{shop.town} {shop.postcode}
				</p>
			</address>
			<Ornament class="text-primary mt-9 max-w-md" />
			<p class="mt-7 text-lg">
				{shop.landmark}, in the city centre.
				<span class="block">{shop.parking}</span>
			</p>

			<div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
				<Cta href={shop.phoneHref}>{`${copy.ring} ${shop.phone}`}</Cta>
				<a
					href={shop.directions}
					class="label border-primary hover:text-primary-accent border-b pt-3 pb-2 transition-colors"
				>
					{copy.visit.openMap}
				</a>
			</div>
		</div>

		<!-- The map runs off the right edge -->
		<div class="mt-14 -mr-5 ml-[10%] md:-mr-10 lg:col-start-7 lg:col-end-13 lg:mt-0">
			<iframe
				src={mapSrc}
				title={`Map showing ${shop.name} at ${shop.street}, ${shop.town}`}
				loading="lazy"
				class="block h-80 w-full contrast-90 grayscale invert-[0.92] lg:h-[40rem]"
			></iframe>
		</div>
	</div>
</section>
