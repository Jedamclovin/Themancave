---
import { Image } from "astro:assets";
import { about } from "@/data/shop";
import chair from "@/assets/demo-1/chair-2.jpg";
---

<section id="about" class="mx-auto max-w-6xl px-6 py-20 md:px-12 md:py-32">
	<div class="grid items-center gap-10 md:grid-cols-12 md:gap-16">
		<Image
			src={chair}
			alt="An antique leather barber chair beside a glass-fronted wooden cabinet"
			widths={[400, 700, 1000]}
			sizes="(min-width: 768px) 40vw, 100vw"
			class="aspect-4/5 w-full rounded-md object-cover md:col-span-5"
		/>
		<div class="md:col-span-7">
			<h2 class="text-4xl md:text-5xl lg:text-6xl">{about.heading}</h2>
			<p class="text-muted-foreground mt-6 max-w-[58ch] text-lg text-pretty md:mt-8 md:text-xl">
				{about.body}
			</p>
		</div>
	</div>
</section>
