---
import { Image } from "astro:assets";
import { about, photos } from "@/data/shop";
---

<!-- The oxblood band. The photo hangs out of the bottom of it, over the paper section below. -->
<section id="about" class="bg-secondary text-secondary-foreground relative z-10">
	<div class="px-5 pt-16 md:px-10 lg:grid lg:grid-cols-12 lg:gap-x-8 lg:pt-28">
		<h2 class="text-[clamp(2.75rem,7.6vw,7.75rem)] leading-[0.94] italic lg:col-span-8 lg:pb-28">
			{about.heading}
		</h2>
		<div class="mt-9 lg:col-start-9 lg:col-end-13 lg:mt-3">
			<p class="max-w-[34ch] text-lg text-pretty">{about.body}</p>
			<Image
				src={photos.about.src}
				alt={photos.about.alt}
				widths={[360, 560, 800]}
				sizes="(min-width: 1024px) 30vw, 72vw"
				class="-mr-5 -mb-24 ml-auto aspect-4/5 w-[72%] max-w-none object-cover mt-10 md:-mr-10 lg:mr-0 lg:-mb-44 lg:w-full"
			/>
		</div>
	</div>
</section>
