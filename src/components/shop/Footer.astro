---
import Ornament from "./Ornament.astro";
import { copy, shop } from "@/data/shop";
---

<footer class="defer-render overflow-x-clip px-5 pt-16 pb-28 md:px-10 md:pt-24 md:pb-12">
	<p
		class="font-display text-[19vw] leading-[0.85] tracking-[-0.035em] italic md:text-[11.9vw] md:whitespace-nowrap"
	>
		{copy.signOff}
	</p>

	<Ornament class="text-primary mt-14 md:mt-20" />

	<div class="mt-8 grid gap-8 md:grid-cols-3">
		<div>
			<p class="label tracking-[0.28em]">{shop.name}</p>
			<p class="text-muted-foreground mt-2">{shop.strapline}</p>
		</div>
		<p>
			{shop.town}
			<a href={shop.phoneHref} class="hover:text-primary-accent block transition-colors">{shop.phone}</a>
		</p>
		<div class="text-muted-foreground text-sm md:text-right">
			<p>{shop.footerNote}</p>
			<p class="mt-1">{shop.photoCredit}</p>
		</div>
	</div>
</footer>
