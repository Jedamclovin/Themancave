---
// No reviews are quoted on the site. This section sends people to the shop's Google listing,
// and shows the Google rating once it is set in the shop data.
import Cta from "./Cta.astro";
import SectionHead from "./SectionHead.astro";
import { copy, shop } from "@/data/shop";

const rating = shop.googleRating;
---

<section id="reviews" class="defer-render overflow-x-clip px-5 py-24 md:px-10 lg:pt-36 lg:pb-40">
	<SectionHead number="03" title={copy.reviews.title} size="sm" />

	<div class="mt-12 lg:mt-16 lg:grid lg:grid-cols-12 lg:items-end lg:gap-x-8">
		<p
			class="font-display text-[clamp(4rem,13vw,13rem)] leading-[0.8] font-black uppercase text-balance lg:col-span-9"
		>
			{copy.reviews.line}
		</p>
		<div class="mt-10 lg:col-start-10 lg:col-end-13 lg:mt-0 lg:pb-2">
			{
				rating && (
					<p class="mb-7">
						<span class="font-display text-primary block text-8xl leading-none font-black tabular-nums">
							{rating.score.toFixed(1)}
						</span>
						<span class="label mt-2 block">
							From {rating.count} {copy.reviews.ratingLabel}
						</span>
					</p>
				)
			}
			<Cta href={shop.googleListing}>{copy.reviews.cta}</Cta>
		</div>
	</div>
</section>
