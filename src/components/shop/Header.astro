---
import { Button } from "@/components/starwind/button";
import { shop } from "@/data/shop";

const links = [
	{ href: "#services", label: "Prices" },
	{ href: "#barbers", label: "Barbers" },
	{ href: "#visit", label: "Hours and location" },
];
---

<header class="absolute inset-x-0 top-0 z-20">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-6 sm:gap-6 py-5 md:px-12 md:py-7">
		<a href="/" class="font-display text-lg tracking-tight whitespace-nowrap sm:text-xl md:text-2xl">{shop.name}</a>
		<nav aria-label="Main" class="flex shrink-0 items-center gap-8">
			<ul class="hidden items-center gap-8 lg:flex">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="hover:text-primary-accent text-sm transition-colors">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<Button variant="primary" size="sm" href="#book">Book a chair</Button>
		</nav>
	</div>
</header>
