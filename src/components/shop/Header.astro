---
import Cta from "./Cta.astro";
import { copy, shop } from "@/data/shop";

const links = [
	{ href: "#services", label: copy.nav.prices },
	{ href: "#barbers", label: copy.nav.chairs },
	{ href: "#visit", label: copy.nav.visit },
];
---

<header class="px-5 md:px-10">
	<div class="border-primary/40 flex items-center justify-between gap-4 border-b py-4 md:py-5">
		<a href="/" class="label text-[0.8125rem] tracking-[0.28em] whitespace-nowrap">{shop.name}</a>
		<nav aria-label="Main" class="flex shrink-0 items-center gap-9">
			<ul class="hidden items-center gap-9 lg:flex">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="label hover:text-primary-accent transition-colors">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<Cta href="#book" class="hidden h-11 px-5 md:inline-flex">{copy.book}</Cta>
			<span class="label text-primary md:hidden">Est. {shop.established}</span>
		</nav>
	</div>
</header>
