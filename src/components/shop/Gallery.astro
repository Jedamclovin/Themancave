---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { copy, gallery } from "@/data/shop";

// Seven places on a 6 column grid (phones) and a 12 column grid (desktop).
// Sizes are deliberately uneven, and the grid runs off the right edge of the screen.
const places = [
	"col-start-1 col-end-7 row-start-1 row-span-4 lg:col-end-8 lg:row-span-6",
	"col-start-1 col-end-4 row-start-5 row-span-5 lg:col-start-8 lg:col-end-11 lg:row-start-2 lg:row-span-6",
	"col-start-4 col-end-7 row-start-5 row-span-3 lg:col-start-11 lg:col-end-13 lg:row-start-1 lg:row-span-4",
	"col-start-4 col-end-7 row-start-8 row-span-2 lg:col-start-3 lg:col-end-8 lg:row-start-7 lg:row-span-5",
	"col-start-1 col-end-5 row-start-10 row-span-3 lg:col-start-11 lg:col-end-13 lg:row-start-5 lg:row-span-3",
	"col-start-2 col-end-7 row-start-13 row-span-3 lg:col-start-8 lg:col-end-13 lg:row-start-8 lg:row-span-4",
	"col-start-1 col-end-4 row-start-16 row-span-5 lg:col-end-3 lg:row-start-9 lg:row-span-4",
];
const aside = "col-start-5 col-end-7 row-start-10 row-span-2 lg:col-start-1 lg:col-end-3 lg:row-start-7 lg:row-span-2";
---

<section id="gallery" class="defer-render overflow-x-clip pb-28 lg:pb-44">
	<SectionHead number="03" title={copy.gallery.title} class="px-5 md:px-10" />
	<ul class="mt-12 grid auto-rows-[15vw] grid-cols-6 gap-2 pl-5 md:pl-10 lg:mt-16 lg:auto-rows-[5.6vw] lg:grid-cols-12 lg:gap-4">
		{
			gallery.slice(0, places.length).map((photo, i) => (
				<li class={places[i]}>
					<Image
						src={photo.src}
						alt={photo.alt}
						widths={[320, 560, 900, 1300]}
						sizes="(min-width: 1024px) 55vw, 92vw"
						class="size-full object-cover"
					/>
				</li>
			))
		}
		<li class:list={["font-display flex items-center text-2xl leading-none italic lg:items-end lg:text-4xl", aside]}>
			{copy.gallery.aside}
		</li>
	</ul>
</section>
