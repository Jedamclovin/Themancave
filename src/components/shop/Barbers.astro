---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { barbers, copy } from "@/data/shop";

// Each chair gets a different width, crop and offset so the pair never reads as two cards.
const slots = [
	{
		item: "lg:col-start-1 lg:col-end-7",
		block: "w-[84%] lg:w-full",
		figure: "-ml-5 md:-ml-10 lg:ml-0",
		ratio: "aspect-4/5",
		numeral: "right-4 -top-12 lg:right-8 lg:-top-24",
	},
	{
		item: "lg:col-start-8 lg:col-end-12 lg:mt-56",
		block: "ml-auto w-[74%] lg:w-full",
		figure: "-mr-5 md:-mr-10 lg:mr-0",
		ratio: "aspect-3/4",
		numeral: "-left-5 -top-12 lg:-left-12 lg:-top-24",
	},
];
---

<section id="barbers" class="defer-render overflow-x-clip px-5 pt-24 pb-28 md:px-10 lg:pt-40 lg:pb-48">
	<div class="lg:grid lg:grid-cols-12 lg:items-end lg:gap-x-8">
		<SectionHead number="02" title={copy.chairs.title} class="lg:col-span-7" />
		<p class="text-muted-foreground mt-6 max-w-[30ch] text-lg lg:col-span-4 lg:col-start-9 lg:pb-3">
			{copy.chairs.intro}
		</p>
	</div>

	<ol class="mt-20 space-y-24 lg:mt-32 lg:grid lg:grid-cols-12 lg:gap-x-8 lg:space-y-0">
		{
			barbers.map((barber, i) => {
				const slot = slots[i % slots.length];
				const number = String(i + 1).padStart(2, "0");
				return (
					<li class={slot.item}>
						<div class={slot.block}>
							<figure class:list={["relative", slot.figure]}>
								<Image
									src={barber.photo.src}
									alt={barber.photo.alt}
									widths={[360, 560, 800, 1100]}
									sizes="(min-width: 1024px) 46vw, 85vw"
									class:list={["w-full max-w-none object-cover", slot.ratio]}
									style={`object-position: ${barber.photo.position}`}
								/>
								<span
									aria-hidden="true"
									class:list={[
										"font-display text-primary absolute text-[7.5rem] leading-none font-black lg:text-[13rem]",
										slot.numeral,
									]}
								>
									{number}
								</span>
							</figure>
							<p class="label text-primary mt-8">
								{copy.chairs.chairLabel} {number}
								{barber.placeholder && <span class="text-muted-foreground">. {copy.chairs.placeholder}</span>}
							</p>
							<h3 class="mt-3 text-6xl font-black lg:text-8xl">{barber.name}</h3>
							<p class="text-muted-foreground mt-4 max-w-[28ch] text-lg">{barber.speciality}</p>
							<a
								href="#book"
								class="label border-primary hover:text-primary-accent mt-4 inline-block border-b pt-3 pb-2 transition-colors"
							>
								{copy.chairs.bookWith} {barber.name}
							</a>
						</div>
					</li>
				);
			})
		}
	</ol>
</section>
