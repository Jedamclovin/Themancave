---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { barbers, copy } from "@/data/shop";

const roman = ["I", "II", "III", "IV", "V", "VI"];

// Each chair gets a different width, crop and offset so the row never reads as a card grid.
const slots = [
	{
		item: "lg:col-span-5",
		block: "w-[84%] lg:w-full",
		figure: "-ml-5 md:-ml-10 lg:ml-0",
		ratio: "aspect-4/5",
		numeral: "right-5 -top-14 lg:right-8 lg:-top-24",
	},
	{
		item: "lg:col-span-4 lg:mt-52",
		block: "ml-auto w-[76%] lg:w-full",
		figure: "-mr-5 md:-mr-10 lg:mr-0",
		ratio: "aspect-3/4",
		numeral: "-left-6 -top-12 lg:-left-10 lg:-top-20",
	},
	{
		item: "lg:col-span-3 lg:mt-20",
		block: "w-[68%] lg:w-full",
		figure: "ml-[14%] lg:ml-0 lg:-mr-10",
		ratio: "aspect-2/3",
		numeral: "-right-9 -top-10 lg:right-6 lg:-top-20",
	},
];
---

<section id="barbers" class="defer-render overflow-x-clip px-5 pt-24 pb-28 md:px-10 lg:pt-40 lg:pb-48">
	<div class="lg:grid lg:grid-cols-12 lg:items-end lg:gap-x-8">
		<SectionHead number="02" title={copy.chairs.title} class="lg:col-span-7" />
		<p class="text-muted-foreground mt-6 max-w-[30ch] text-lg lg:col-span-4 lg:col-start-9 lg:pb-3">
			{copy.chairs.intro}
		</p>
	</div>

	<ol class="mt-20 space-y-24 lg:mt-28 lg:grid lg:grid-cols-12 lg:gap-x-8 lg:space-y-0">
		{
			barbers.map((barber, i) => {
				const slot = slots[i % slots.length];
				return (
					<li class={slot.item}>
						<div class={slot.block}>
							<figure class:list={["relative", slot.figure]}>
								<Image
									src={barber.photo.src}
									alt={barber.photo.alt}
									widths={[360, 560, 800]}
									sizes="(min-width: 1024px) 40vw, 85vw"
									class:list={["w-full max-w-none object-cover", slot.ratio]}
									style={`object-position: ${barber.photo.position}`}
								/>
								<span
									aria-hidden="true"
									class:list={[
										"font-display text-primary absolute text-[7.5rem] leading-none lg:text-[12rem]",
										slot.numeral,
									]}
								>
									{roman[i]}
								</span>
							</figure>
							<p class="label text-primary mt-9">
								{copy.chairs.chairLabel} {roman[i]}
							</p>
							<h3 class="mt-3 text-[2.75rem] lg:text-6xl">{barber.name}</h3>
							<p class="text-muted-foreground mt-4 max-w-[28ch]">
								{barber.speciality} {barber.detail}
							</p>
							<a
								href="#book"
								class="label border-primary hover:text-primary-accent mt-4 inline-block border-b pt-3 pb-2 transition-colors"
							>
								Book {barber.firstName}'s chair
							</a>
						</div>
					</li>
				);
			})
		}
	</ol>
</section>
