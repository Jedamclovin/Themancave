---
import Cta from "./Cta.astro";
import Ornament from "./Ornament.astro";
import SectionHead from "./SectionHead.astro";
import { copy, services, shop } from "@/data/shop";

// Each line starts a little further in or out, so the list never reads as a table.
const insets = ["", "lg:pl-[7%]", "lg:pl-[3%]", "lg:pl-[11%]"];
---

<!-- The board: light, heavy capitals, the booking notice pasted on at an angle -->
<section id="board" class="defer-render bg-paper text-paper-foreground overflow-x-clip">
	<div class="px-5 pt-40 pb-24 md:px-10 lg:grid lg:grid-cols-12 lg:gap-x-8 lg:pt-24 lg:pb-36">
		<div class="lg:col-span-4">
			<SectionHead number="01" title={copy.board.title} tone="paper" />
			<p class="mt-6 max-w-[20ch] text-xl font-semibold text-pretty">{copy.board.aside}</p>
		</div>

		<div class="mt-12 lg:col-start-5 lg:col-end-13 lg:mt-40">
			<Ornament class="text-secondary" />
			<ol class="mt-4">
				{
					services.map((item, i) => (
						<li
							class:list={[
								"border-paper-foreground flex items-end gap-4 border-b-2 pt-5 pb-3 lg:pt-7 lg:pb-4",
								insets[i % insets.length],
							]}
						>
							<span class="label text-secondary w-7 shrink-0 pb-1">{String(i + 1).padStart(2, "0")}</span>
							<span class="font-display flex-1 text-[clamp(2.75rem,11.5vw,7.5rem)] leading-none font-black uppercase">
								{item.name}
							</span>
							{item.price !== undefined && (
								<span class="shrink-0 text-right">
									<span class="font-display text-secondary block text-[clamp(2.75rem,9vw,6rem)] leading-none font-black tabular-nums">
										£{item.price}
									</span>
									{item.minutes && <span class="label text-paper-muted mt-2 block">{item.minutes} min</span>}
								</span>
							)}
						</li>
					))
				}
			</ol>
			{!shop.pricesConfirmed && <p class="label text-paper-muted mt-5">{copy.board.examplePrices}</p>}

			<div
				class="bg-secondary text-secondary-foreground mt-12 mr-1 ml-6 -rotate-2 px-6 py-6 md:ml-[42%] md:px-8 md:py-7"
			>
				<p class="font-display text-4xl leading-none font-black uppercase md:text-5xl">{copy.board.noticeLabel}</p>
				<Cta href="#book" class="mt-5">{copy.book}</Cta>
			</div>
		</div>
	</div>
</section>
