---
import Ornament from "./Ornament.astro";
import SectionHead from "./SectionHead.astro";
import { copy, services, shop } from "@/data/shop";

// Each line starts a little further in or out, so the list never reads as a table.
const insets = ["", "lg:pl-[9%]", "lg:pl-[3%]", "lg:pl-[14%]"];
---

<!-- The board: light, heavy capitals, the prices notice pasted on at an angle -->
<section id="board" class="defer-render bg-paper text-paper-foreground overflow-x-clip">
	<div class="px-5 pt-40 pb-24 md:px-10 lg:grid lg:grid-cols-12 lg:gap-x-8 lg:pt-24 lg:pb-36">
		<div class="lg:col-span-4">
			<SectionHead number="01" title={copy.board.title} tone="paper" />
			<p class="mt-6 max-w-[20ch] text-xl font-semibold text-pretty">{copy.board.aside}</p>
		</div>

		<div class="mt-12 lg:col-start-5 lg:col-end-13 lg:mt-40">
			<Ornament class="text-secondary" />
			<ol class="mt-4">
				{
					services.map((item, i) => (
						<li
							class:list={[
								"border-paper-foreground flex items-baseline gap-4 border-b-2 pt-5 pb-3 lg:pt-7 lg:pb-4",
								insets[i % insets.length],
							]}
						>
							<span class="label text-secondary w-7 shrink-0">{String(i + 1).padStart(2, "0")}</span>
							<span class="font-display flex-1 text-[clamp(3rem,13.5vw,8.5rem)] leading-[0.84] font-black uppercase">
								{item.name}
							</span>
							{item.price !== undefined && (
								<span class="font-display text-secondary text-[clamp(2.25rem,8vw,5.5rem)] leading-none font-black tabular-nums">
									£{item.price}
								</span>
							)}
						</li>
					))
				}
			</ol>

			<div
				class="bg-secondary text-secondary-foreground mt-12 -mr-8 ml-6 -rotate-2 px-6 py-6 sm:-mr-12 md:-mr-16 md:ml-[42%] md:px-8 md:py-7"
			>
				<p class="label text-primary-accent">{copy.board.noticeLabel}</p>
				<p class="mt-3 max-w-[22ch] text-lg font-semibold">{copy.board.notice}</p>
				<a
					href={shop.phoneHref}
					class="font-display hover:text-primary-accent mt-2 inline-block text-6xl leading-none font-black tabular-nums transition-colors md:text-7xl"
				>
					{shop.phone}
				</a>
			</div>
		</div>
	</div>
</section>
