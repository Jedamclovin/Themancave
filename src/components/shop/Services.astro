---
import { Button } from "@/components/starwind/button";
import { serviceGroups } from "@/data/shop";
---

<section id="services" class="bg-card scroll-mt-0">
	<div class="mx-auto max-w-6xl px-3 py-16 sm:px-6 md:px-12 md:py-28">
		<!-- Framed like the price board on a barbershop wall -->
		<div class="border-primary/70 border p-1.5">
			<div class="border-primary/40 border px-5 py-10 sm:px-8 md:px-14 md:py-16">
				<div class="text-center">
					<h2 class="text-4xl md:text-6xl">Price list</h2>
				</div>

				<div class="mt-12 grid gap-x-14 gap-y-12 md:mt-16 lg:grid-cols-3">
					{
						serviceGroups.map((group) => (
							<div>
								<h3 class="text-primary-accent border-primary/40 border-b pb-3 text-2xl italic">
									{group.title}
								</h3>
								<ul class="mt-5 space-y-5">
									{group.items.map((item) => (
										<li>
											<div class="flex items-baseline">
												<span class="text-lg font-medium">{item.name}</span>
												<span
													aria-hidden="true"
													class="border-primary/70 mx-3 min-w-6 flex-1 -translate-y-1 border-b-2 border-dotted"
												/>
												<span class="font-display text-2xl tabular-nums">£{item.price}</span>
											</div>
											<p class="text-muted-foreground mt-1 text-sm">
												{item.minutes} min{item.note ? `. ${item.note}.` : ""}
											</p>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>

				<div class="mt-12 text-center md:mt-16">
					<Button variant="primary" size="lg" href="#book">Book a chair</Button>
				</div>
			</div>
		</div>
	</div>
</section>
