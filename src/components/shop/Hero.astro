---
import { Image } from "astro:assets";
import { Button } from "@/components/starwind/button";
import { hours, shop } from "@/data/shop";
import hero from "@/assets/demo-1/hero.jpg";

// Shown until the script in Visit.astro swaps in today's hours
const openDays = hours.filter((row) => row.open);
---

<section class="relative isolate flex min-h-svh flex-col justify-end overflow-hidden">
	<Image
		src={hero}
		alt="Three leather barber chairs facing mirrors on a brick wall, lit by warm pendant lamps"
		widths={[640, 960, 1440, 1920, 2400]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
		class="motion-safe:animate-settle absolute inset-0 -z-20 size-full object-cover"
	/>
	<div class="from-background via-background/70 to-background/30 absolute inset-0 -z-10 bg-linear-to-t"></div>

	<div class="mx-auto w-full max-w-6xl px-6 pt-32 pb-10 md:px-12 md:pb-16">
		<h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl">{shop.name}</h1>
		<p class="text-primary-accent mt-4 text-lg md:mt-5 md:text-xl">{shop.strapline}</p>
		<p class="font-display mt-6 max-w-[24ch] text-2xl italic text-pretty md:mt-8 md:text-4xl">
			{shop.tagline}
		</p>
		<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4 md:mt-10 md:gap-x-8">
			<Button variant="primary" size="lg" href="#book" class="px-6 md:px-8">Book a chair</Button>
			<a
				href="#services"
				class="decoration-primary hover:text-primary-accent text-base underline md:text-lg decoration-1 underline-offset-8 transition-colors"
			>
				See the price list
			</a>
		</div>
		<p class="border-border text-muted-foreground mt-12 border-t pt-5 text-sm md:mt-16">
			<span data-today-hours>Open {openDays[0].day} to {openDays[openDays.length - 1].day}.</span>{" "}
			{shop.town}. Walk-ins welcome.
		</p>
	</div>
</section>
