---
import { Image } from "astro:assets";
import Cta from "./Cta.astro";
import Nameplate from "./Nameplate.astro";
import { copy, photos, shop } from "@/data/shop";

const [firstLine, ...otherLines] = shop.signLines;
---

<section class="relative overflow-x-clip pb-20 lg:pb-32">
	<!-- The fascia: the shop sign, set as large as the screen allows, with "The" on its side as on the real one -->
	<div class="bg-sign text-sign-foreground px-5 pt-7 pb-[19vw] md:px-10 md:pt-9 lg:pb-16">
		<p class="label text-primary-accent">{shop.strapline}</p>
		<h1
			class="sign-raised mt-5 text-[43vw] leading-[0.8] font-black text-nowrap lg:mt-6 lg:text-[min(25.5vw,31rem)]"
		>
			<span class="flex items-stretch">
				<span
					class="mr-[0.07em] -ml-[0.02em] rotate-180 self-center text-[0.235em] leading-none tracking-[0.04em] [writing-mode:vertical-rl]"
				>
					{shop.signPrefix}
				</span>
				<span>{firstLine}</span>
			</span>
			{otherLines.map((line) => <span class="block">{line}</span>)}
		</h1>
	</div>

	<div class="px-5 md:px-10 lg:grid lg:grid-cols-12 lg:gap-x-8">
		<!-- The photo hangs off the bottom of the fascia and runs off the right edge -->
		<figure
			class="relative z-10 -mt-[13vw] -mr-5 ml-[16%] md:-mr-10 lg:col-start-8 lg:col-end-13 lg:row-start-1 lg:-mt-[min(27vw,33rem)] lg:ml-0"
		>
			<Image
				src={photos.hero.src}
				alt={photos.hero.alt}
				widths={[480, 800, 1100, 1500]}
				sizes="(min-width: 1024px) 42vw, 84vw"
				loading="eager"
				fetchpriority="high"
				class="aspect-4/5 w-full object-cover lg:aspect-3/4"
				style={`object-position: ${photos.hero.position}`}
			/>
			<Nameplate class="absolute -bottom-6 -left-[14%] -rotate-3 lg:-bottom-8 lg:-left-16" />
		</figure>

		<div class="mt-16 lg:col-start-1 lg:col-end-7 lg:row-start-1 lg:mt-14">
			<p class="font-display text-[2.6rem] leading-[0.95] font-bold uppercase text-balance lg:text-[min(4.4vw,5rem)]">
				{shop.tagline}
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3">
				<Cta href={shop.phoneHref}>{`${copy.ring} ${shop.phone}`}</Cta>
				<a
					href="#clocks"
					class="label border-primary hover:text-primary-accent border-b pt-3 pb-2 transition-colors"
				>
					{copy.seeHours}
				</a>
			</div>
			<p class="label text-muted-foreground mt-10 leading-relaxed">
				<span data-today-hours>Open seven days.</span>
				<span class="block">{shop.street}, {shop.town}. {shop.landmark}.</span>
			</p>
		</div>
	</div>
</section>
