---
import "@/styles/starwind.css";
import { hours, shop } from "@/data/shop";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

// Tells search engines the shop's address, phone and hours
const pad = (time: string) => time.padStart(5, "0");
const business = {
	"@context": "https://schema.org",
	"@type": "HairSalon",
	name: shop.name,
	telephone: shop.phoneIntl,
	address: {
		"@type": "PostalAddress",
		streetAddress: shop.street,
		addressLocality: shop.town,
		postalCode: shop.postcode,
		addressCountry: "GB",
	},
	geo: { "@type": "GeoCoordinates", latitude: shop.map.lat, longitude: shop.map.lon },
	sameAs: [shop.instagram.url],
	openingHoursSpecification: hours
		.filter((row) => row.open && row.close)
		.map((row) => ({
			"@type": "OpeningHoursSpecification",
			dayOfWeek: row.day,
			opens: pad(row.open!),
			closes: pad(row.close!),
		})),
};
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="description" content={description} />
		{shop.draft && <meta name="robots" content="noindex, nofollow" />}
		{/* The card shown when the link is shared on WhatsApp, Instagram, Facebook and so on */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={shop.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={new URL("/", Astro.site)} />
		{/* Square, because WhatsApp shows the preview as a small square and crops anything wider */}
		<meta property="og:image" content={new URL("/share.jpg", Astro.site)} />
		<meta property="og:image:width" content="800" />
		<meta property="og:image:height" content="800" />
		<meta property="og:image:alt" content={`${shop.name} mark`} />
		<meta name="twitter:card" content="summary" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(business)} />
	</head>
	<body>
		<a
			href="#main"
			class="bg-primary text-primary-foreground sr-only z-50 px-4 py-2 focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
		>
			Skip to content
		</a>
		<slot />
		<script>
			// Smooth scrolling and scroll reveals. Fetched once the page has loaded and the browser is idle,
			// so it never slows the first view. Skipped entirely for people who prefer reduced motion.
			if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
				const start = () => import("@/scripts/motion").then((motion) => motion.startMotion());
				const whenIdle = () =>
					"requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 600);
				if (document.readyState === "complete") whenIdle();
				else addEventListener("load", whenIdle, { once: true });
			}
		</script>
	</body>
</html>
